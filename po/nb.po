msgid "a known distribution"
msgstr "en kjent distribusjon"

#: src/gui/gaudit-window.c:135
msgid "Package system"
msgstr "Pakkesystem"

#: src/gui/gaudit-window.c:140
msgid "Software needed to check snaps is missing"
msgstr "Programvare som trengs for å sjekke snaps, mangler"

#: src/gui/gaudit-window.c:142
msgid "The snap service is not running, so snaps are not updated"
msgstr "Snap-tjenesten kjører ikke, så snaps blir ikke oppdatert"

#: src/gui/gaudit-window.c:144
msgid "Could not check the snaps"
msgstr "Kunne ikke sjekke snapene"

