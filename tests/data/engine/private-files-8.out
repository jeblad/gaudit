(report (verdict warning) (title (msgn "{n} secret can be read by others" "{n} secrets can be read by others" 1 (n 1))) (description (msg "Anyone who can use these accounts can copy them. Open each one marked with a warning to see how to close it.")))
(home (verdict warning) (title (msgn "{n} secret can be read by members of a group" "{n} secrets can be read by members of a group" 1 (n 1))) (subtitle (msg "Accounts in a group with access can copy them")))
(home (verdict unknown) (title (msgn "{n} secret on a network folder may be readable by others" "{n} secrets on network folders may be readable by others" 1 (n 1))) (subtitle (msg "The server decides who can read them")))
(section (title (msg "Members of a group can read these")) (description (msg "Accounts in a group that has access to the file, or to a folder on the way, can read them.")))
(row (verdict warning) (title (text "/mnt/data/old/backup.kdbx")) (subtitle (msg "{kind} · {mode}" (kind (msg "KeePass password database")) (mode "0664"))) (fix make-private (item 3)))
(section (title (msg "On network folders, perhaps readable by others")) (description (msg "This computer shows them as readable by others, but on a network folder the server decides.")))
(row (verdict unknown) (title (text "/net/share/keys/server.pem")) (subtitle (msg "{kind} · {mode} · on a network folder" (kind (msg "Private key")) (mode "0644"))) (fix make-private (item 4)))
(note (msg "Also searched: {path}" (path "/mnt/data")))
(note (msg "Also searched: {path}" (path "/net/share")))
