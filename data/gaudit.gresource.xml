<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<!-- Compiled into the GUI, so every icon the app uses is always there.
     GtkApplication adds <app path>/icons to the icon search: these are
     found by name. The active icon theme still wins where it has the same
     name, so the look follows the user's theme; these are the fallback. -->
<gresources>
  <gresource prefix="/io/github/jeblad/gaudit/icons/scalable/actions">
    <!-- From the GNOME icon library, Jakub Steiner, CC0. -->
    <file preprocess="xml-stripblanks" alias="gaudit-fire-symbolic.svg">icons/scalable/actions/gaudit-fire-symbolic.svg</file>
    <!-- Exported with the Icon Library app; source and license to be confirmed. -->
    <file preprocess="xml-stripblanks" alias="emblem-ok-symbolic.svg">icons/scalable/actions/emblem-ok-symbolic.svg</file>
    <!-- From adwaita-icon-theme, the GNOME Project, used under LGPL-3.0
         (dual-licensed LGPL-3.0 or CC-BY-SA-3.0). -->
    <file preprocess="xml-stripblanks" alias="content-loading-symbolic.svg">icons/scalable/actions/content-loading-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="dialog-error-symbolic.svg">icons/scalable/actions/dialog-error-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="dialog-information-symbolic.svg">icons/scalable/actions/dialog-information-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="dialog-password-symbolic.svg">icons/scalable/actions/dialog-password-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="dialog-question-symbolic.svg">icons/scalable/actions/dialog-question-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="dialog-warning-symbolic.svg">icons/scalable/actions/dialog-warning-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="edit-copy-symbolic.svg">icons/scalable/actions/edit-copy-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-home-symbolic.svg">icons/scalable/actions/gaudit-home-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="go-next-symbolic.svg">icons/scalable/actions/go-next-symbolic.svg</file>
    <!-- Mirrored for right-to-left, under both names GTK has looked for. -->
    <file preprocess="xml-stripblanks" alias="go-next-rtl-symbolic.svg">icons/scalable/actions/go-next-rtl-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="go-next-symbolic-rtl.svg">icons/scalable/actions/go-next-rtl-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="open-menu-symbolic.svg">icons/scalable/actions/open-menu-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="preferences-system-symbolic.svg">icons/scalable/actions/preferences-system-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="system-software-install-symbolic.svg">icons/scalable/actions/system-software-install-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="folder-symbolic.svg">icons/scalable/actions/folder-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="folder-publicshare-symbolic.svg">icons/scalable/actions/folder-publicshare-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="folder-remote-symbolic.svg">icons/scalable/actions/folder-remote-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="list-add-symbolic.svg">icons/scalable/actions/list-add-symbolic.svg</file>
    <!-- Drawn for gAudit, GPL-3.0-only: a link that opens in the browser.
         Mirrored for right-to-left, under both names GTK has looked for. -->
    <file preprocess="xml-stripblanks" alias="gaudit-external-link-symbolic.svg">icons/scalable/actions/gaudit-external-link-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-external-link-rtl-symbolic.svg">icons/scalable/actions/gaudit-external-link-rtl-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-external-link-symbolic-rtl.svg">icons/scalable/actions/gaudit-external-link-rtl-symbolic.svg</file>
    <!-- gAudit's own names, so no icon theme can replace them: the shape
         carries the meaning. The shield outline is adwaita-icon-theme's
         security-* (LGPL-3.0, as above); high, medium and low are those
         icons renamed, ok and unknown add a check mark and a question mark. -->
    <file preprocess="xml-stripblanks" alias="gaudit-status-ok-symbolic.svg">icons/scalable/actions/gaudit-status-ok-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-status-high-symbolic.svg">icons/scalable/actions/gaudit-status-high-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-status-medium-symbolic.svg">icons/scalable/actions/gaudit-status-medium-symbolic.svg</file>
    <!-- Half filled from the side reading starts on: mirrored for RTL, under
         both names GTK has looked for (as adwaita-icon-theme ships them). -->
    <file preprocess="xml-stripblanks" alias="gaudit-status-medium-rtl-symbolic.svg">icons/scalable/actions/gaudit-status-medium-rtl-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-status-medium-symbolic-rtl.svg">icons/scalable/actions/gaudit-status-medium-rtl-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-status-low-symbolic.svg">icons/scalable/actions/gaudit-status-low-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-status-unknown-symbolic.svg">icons/scalable/actions/gaudit-status-unknown-symbolic.svg</file>
    <!-- The Updates plugin's sidebar icon: adwaita-icon-theme's
         package-x-generic-symbolic (LGPL-3.0, as above), renamed. -->
    <file preprocess="xml-stripblanks" alias="gaudit-packages-symbolic.svg">icons/scalable/actions/gaudit-packages-symbolic.svg</file>
    <!-- A plugin's reports in its sidebar folder: the Yaru icon theme's
         emblem-documents-symbolic, (c) 2018 Sam Hewitt, CC-BY-SA-4.0
         (https://github.com/ubuntu/yaru), renamed so no theme can change it. -->
    <file preprocess="xml-stripblanks" alias="gaudit-documents-symbolic.svg">icons/scalable/actions/gaudit-documents-symbolic.svg</file>
    <!-- Taking an entry off a list (nothing is deleted, so no bin): the
         GNOME icon library's ⨯-button-symbolic, Jakub Steiner, CC0, under its
         own name. -->
    <file preprocess="xml-stripblanks" alias="gaudit-remove-symbolic.svg">icons/scalable/actions/gaudit-remove-symbolic.svg</file>
    <!-- Running a fix gAudit can do itself, beside the copy button: the
         GNOME icon library's pegged-wheels-symbolic, Jakub Steiner, CC0,
         under its own name. -->
    <file preprocess="xml-stripblanks" alias="gaudit-run-symbolic.svg">icons/scalable/actions/gaudit-run-symbolic.svg</file>
    <!-- The page's context menu in the content's header bar: the Yaru icon
         theme's view-more-symbolic, (c) 2018 Sam Hewitt, CC-BY-SA-4.0
         (https://github.com/ubuntu/yaru), renamed. -->
    <file preprocess="xml-stripblanks" alias="gaudit-context-menu-symbolic.svg">icons/scalable/actions/gaudit-context-menu-symbolic.svg</file>
    <!-- Reload in the content's header bar: adwaita-icon-theme's
         view-refresh-symbolic (LGPL-3.0, as above), renamed. Not mirrored
         for right-to-left: clockwise is a clock's way, not reading's. -->
    <file preprocess="xml-stripblanks" alias="gaudit-reload-symbolic.svg">icons/scalable/actions/gaudit-reload-symbolic.svg</file>
    <!-- A recommendation in a report (advice): adwaita-icon-theme's
         dialog-information-symbolic (LGPL-3.0, as above), renamed so no
         theme can replace it. -->
    <file preprocess="xml-stripblanks" alias="gaudit-information-symbolic.svg">icons/scalable/actions/gaudit-information-symbolic.svg</file>
    <!-- The Private Files plugin's sidebar icon: adwaita-icon-theme's
         dialog-password-symbolic (LGPL-3.0, as above), renamed. -->
    <file preprocess="xml-stripblanks" alias="gaudit-private-files-symbolic.svg">icons/scalable/actions/gaudit-private-files-symbolic.svg</file>
    <!-- The user/administrator switch: from the GNOME icon library, Jakub
         Steiner, CC0 (one person, and two, the front one in the accent
         colour), under own names so no theme can change or hide them. -->
    <file preprocess="xml-stripblanks" alias="gaudit-user-symbolic.svg">icons/scalable/actions/gaudit-user-symbolic.svg</file>
    <file preprocess="xml-stripblanks" alias="gaudit-superuser-symbolic.svg">icons/scalable/actions/gaudit-superuser-symbolic.svg</file>
    <!-- A Home row that cannot run until the user switches to administrator:
         something must be done. The GNOME icon library's
         questionmark-symbolic, Jakub Steiner, CC0, under its own name. -->
    <file preprocess="xml-stripblanks" alias="gaudit-questionmark-symbolic.svg">icons/scalable/actions/gaudit-questionmark-symbolic.svg</file>
  </gresource>
</gresources>
