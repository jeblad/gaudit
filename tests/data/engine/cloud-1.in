(input (system (host "h") (distro "Ubuntu 26.10") (backend "debian"))
 (level "quick")
 (collection
  (cloud-folder (client "dropbox") (service "dropbox") (how 0) (path "~/Cloud/Dropbox") (name "") (encrypted 0) (via "") (gathered 1))
  (cloud-folder (client "insync") (service "google-drive") (how 0) (path "~/Insync/me@example.com/Google Drive") (name "me@example.com") (encrypted 0) (via "") (gathered 0))
  (cloud-folder (client "rclone") (service "google-drive") (how 4) (path "") (name "gdrive") (encrypted 1) (via "secret") (gathered 0))
  (cloud-folder (client "pcloud") (service "pcloud") (how 3) (path "~/pCloudDrive") (name "") (encrypted 0) (via "") (gathered 0))
  (cloud-folder (client "tresorit") (service "tresorit") (how 2) (path "") (name "") (encrypted 0) (via "") (gathered 0))
  (cloud-end (count 5) (more 0) (gathering "~/Cloud") (gatherings 1) (rclone-unreadable 0))))
