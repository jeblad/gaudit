msgid_plural "%u private files or folders can be reached by others, e.g. %s"
msgstr[0] "%u privat fil eller mappe kan nås av andre: %s"
msgstr[1] "%u private filer eller mapper kan nås av andre, f.eks. %s"

#: src/gui/gaudit-window.c:237
