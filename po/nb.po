#, c-format
msgid "probably replaced by the snap %s"
msgstr "trolig erstattet av snappen %s"

#: src/gui/gaudit-sourceless-page.c:113
msgid "no other package depends on it"
msgstr "ingen andre pakker er avhengige av den"

#. Translators: %s is a few package names, %d how many more.
#: src/gui/gaudit-sourceless-page.c:116
#, c-format
msgid "%s and %d more depend on it"
msgid_plural "%s and %d more depend on it"
msgstr[0] "%s og %d til er avhengige av den"
msgstr[1] "%s og %d til er avhengige av den"

#. Translators: %s is one to three package names.
#: src/gui/gaudit-sourceless-page.c:122
#, c-format
msgid "%s depends on it"
msgstr "%s er avhengig av den"

#: src/gui/gaudit-sourceless-page.c:124
msgid "installed on purpose"
msgstr "installert med vilje"

#: src/gui/gaudit-sourceless-page.c:126
msgid "installed as a dependency"
msgstr "installert som avhengighet"

#. Translators: %s is a date.
#: src/gui/gaudit-sourceless-page.c:132
#, c-format
msgid "installed or upgraded %s"
msgstr "installert eller oppgradert %s"

#: src/gui/gaudit-sourceless-page.c:146
msgid ""
"These installed packages are not offered by any software source in the "
"version installed, so the system's updates do not reach them."
msgstr ""
"Disse installerte pakkene tilbys ikke av noen programvarekilde i den "
"versjonen som er installert, så systemets oppdateringer når dem ikke."

#. Translators: versions, e.g. "Installed 1.0.8-6ubuntu0.1, the source has 1.0.8-6build2".
#: src/gui/gaudit-sourceless-page.c:169
#, c-format
msgid "Installed %s, the source has %s"
msgstr "Installert %s, kilden har %s"

#: src/gui/gaudit-sourceless-page.c:170
#, c-format
msgid "Installed %s"
msgstr "Installert %s"

#: src/gui/gaudit-sourceless-page.c:185
msgid "Not every package without a source could be listed."
msgstr "Ikke alle pakker uten kilde kunne listes."

#: src/gui/gaudit-sourceless-page.c:189
#, c-format
msgid "Showing %u of %u packages."
msgstr "Viser %u av %u pakker."

#: src/gui/gaudit-sourceless-page.c:200
msgid "Could not list the packages"
msgstr "Kunne ikke liste pakkene"

#: src/gui/gaudit-sourceless-page.c:201
msgid "Nothing is known about them from this attempt."
msgstr "Dette forsøket ga ingen kunnskap om dem."

#
#: src/gui/gaudit-sourceless-page.c:204
msgid "The program cannot list these packages here yet."
msgstr "Programmet kan ikke liste disse pakkene her ennå."

#: src/gui/gaudit-sourceless-page.c:206
msgid "Every package has a source"
msgstr "Alle pakker har en kilde"

#: src/gui/gaudit-sourceless-page.c:244
msgid "Looking at the packages…"
msgstr "Ser på pakkene …"

#: src/gui/gaudit-sourceless-page.c:267
msgid "Packages Without a Source"
msgstr "Pakker uten kilde"

