msgid "Not available on this system"
msgstr "Ikke tilgjengelig på dette systemet"

#: src/gui/gaudit-window.c:754 src/gui/gaudit-task-page.c:1046
msgid "Software is missing"
msgstr "Programvare mangler"

#: src/gui/gaudit-window.c:757
msgid "Not run yet"
msgstr "Ikke kjørt ennå"

#: src/gui/gaudit-window.c:829
msgid "checked as Debian"
msgstr "sjekkes som Debian"

#: src/gui/gaudit-window.c:830
msgid "checked as Fedora"
msgstr "sjekkes som Fedora"

#: src/gui/gaudit-window.c:831
msgid "checked as Arch"
msgstr "sjekkes som Arch"

#: src/gui/gaudit-window.c:832
msgid "general checks only"
msgstr "bare generelle sjekker"

#: src/gui/gaudit-window.c:835
msgid "Unknown system"
msgstr "Ukjent system"

#. Translators: "<system> · <how gAudit checks it>",
#. * e.g. "Ubuntu 26.04 LTS · checked as Debian".
