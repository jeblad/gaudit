#, c-format
msgid "%s · %s"
msgstr "%s · %s"

#: src/gui/gaudit-window.c:870
msgid "This computer"
msgstr "Denne maskinen"

#: src/gui/gaudit-window.c:874
msgid "Unknown host name"
msgstr "Ukjent vertsnavn"

#: src/gui/gaudit-window.c:898 src/gui/gaudit-window.c:1331
msgid "Home"
msgstr "Hjem"

#. Translators: the content's title inside a plugin, "<plugin> › <page>",
#. * e.g. "Private Files › Parameters". Turn the separator around for
#. * right-to-left languages if it reads wrong.
#: src/gui/gaudit-window.c:916
#, c-format
msgid "%s › %s"
msgstr "%s › %s"

#: src/gui/gaudit-window.c:994 src/gui/gaudit-window.c:1041
msgid "Parameters"
msgstr "Parametere"

