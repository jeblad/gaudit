#, c-format
msgid "%u snap is held back from updates"
msgid_plural "%u snaps are held back from updates"
msgstr[0] "%u snap holdes tilbake fra oppdateringer"
msgstr[1] "%u snaps holdes tilbake fra oppdateringer"

#: src/gui/gaudit-window.c:171
#, c-format
msgid "%u snap runs in developer mode, without a working sandbox"
msgid_plural "%u snaps run in developer mode, without a working sandbox"
msgstr[0] "%u snap kjører i utviklermodus, uten en fungerende sandkasse"
msgstr[1] "%u snaps kjører i utviklermodus, uten en fungerende sandkasse"

#: src/gui/gaudit-window.c:178
