(row (verdict ok) (title (msg "Updates are installed automatically")) (subtitle (msg "Last run {when}" (when (msgn "{n} hour ago" "{n} hours ago" 8 (n 8))))))
(section (title (msg "Where updates come from")) (description (msg "Security updates should come straight from the distribution, and every installed package from a software source.")))
