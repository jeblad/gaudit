msgstr[1] "%u snaps kjører uten sandkasse med vilje (classic)"

#: src/gui/gaudit-window.c:263
msgid "Snap apps"
msgstr "Snap-apper"

#: src/gui/gaudit-window.c:267
msgid "An antivirus program is installed"
msgstr "Et antivirusprogram er installert"

#: src/gui/gaudit-window.c:268
msgid "No antivirus program found"
msgstr "Fant ikke noe antivirusprogram"

#: src/gui/gaudit-window.c:269
msgid "Antivirus program"
msgstr "Antivirusprogram"

#: src/gui/gaudit-window.c:273
msgid "A firewall is installed"
msgstr "En brannmur er installert"

#: src/gui/gaudit-window.c:274
msgid "No firewall found"
msgstr "Fant ingen brannmur"

#: src/gui/gaudit-window.c:275
msgid "Firewall program"
msgstr "Brannmurprogram"

#: src/gui/gaudit-window.c:279
msgid "Could not find out which services listen on the network"
msgstr "Kunne ikke finne ut hvilke tjenester som lytter på nettverket"

#: src/gui/gaudit-window.c:281
msgid "No services listen for connections from the network"
msgstr "Ingen tjenester lytter etter tilkoblinger fra nettverket"

#: src/gui/gaudit-window.c:284
#, c-format
msgid "%u service listens for connections from the network."
msgid_plural "%u services listen for connections from the network."
msgstr[0] "%u tjeneste lytter etter tilkoblinger fra nettverket."
msgstr[1] "%u tjenester lytter etter tilkoblinger fra nettverket."

#: src/gui/gaudit-window.c:288
msgid "None of them run under your account."
msgstr "Ingen av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:289
#, c-format
msgid "%u of them runs under your account."
msgid_plural "%u of them run under your account."
msgstr[0] "%u av dem kjører under kontoen din."
msgstr[1] "%u av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:294
msgid "The firewall check shows whether they can be reached."
msgstr "Brannmursjekken viser om de kan nås."

#: src/gui/gaudit-window.c:296
msgid "Network services"
msgstr "Nettverkstjenester"

#: src/gui/gaudit-window.c:300
msgid "Software needed to check Flatpak apps is missing"
msgstr "Programvare som trengs for å sjekke Flatpak-apper, mangler"

#: src/gui/gaudit-window.c:302
msgid "Could not check the Flatpak apps"
msgstr "Kunne ikke sjekke Flatpak-appene"

#: src/gui/gaudit-window.c:304
