msgid "Not available on this system"
msgstr "Ikke tilgjengelig på dette systemet"

#: src/gui/gaudit-window.c:805 src/gui/gaudit-task-page.c:584
msgid "Software is missing"
msgstr "Programvare mangler"

#: src/gui/gaudit-window.c:807
msgid "Not run yet"
msgstr "Ikke kjørt ennå"

#: src/gui/gaudit-window.c:808
msgid "Switch to administrator to run this check"
msgstr "Bytt til administrator for å kjøre denne sjekken"

#: src/gui/gaudit-window.c:858
msgid "checked as Debian"
msgstr "sjekkes som Debian"

#: src/gui/gaudit-window.c:859
msgid "checked as Fedora"
