#, c-format
msgid "Packages managed by %s are not checked"
msgstr "Pakker som styres av %s, blir ikke sjekket"

#: src/gui/gaudit-window.c:252
msgid "Other package systems"
msgstr "Andre pakkesystemer"

#: src/gui/gaudit-window.c:257
msgid "An antivirus program is installed"
msgstr "Et antivirusprogram er installert"

#: src/gui/gaudit-window.c:258
msgid "No antivirus program found"
msgstr "Fant ikke noe antivirusprogram"

#: src/gui/gaudit-window.c:259
msgid "Antivirus"
msgstr "Antivirus"

