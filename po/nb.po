msgid "Could not find out which services listen on the network"
msgstr "Kunne ikke finne ut hvilke tjenester som lytter på nettverket"

#: src/gui/gaudit-window.c:271
msgid "No services listen for connections from the network"
msgstr "Ingen tjenester lytter etter tilkoblinger fra nettverket"

#: src/gui/gaudit-window.c:274
#, c-format
msgid "%u service listens for connections from the network."
msgid_plural "%u services listen for connections from the network."
msgstr[0] "%u tjeneste lytter etter tilkoblinger fra nettverket."
msgstr[1] "%u tjenester lytter etter tilkoblinger fra nettverket."

#: src/gui/gaudit-window.c:278
msgid "None of them run under your account."
msgstr "Ingen av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:279
#, c-format
msgid "%u of them runs under your account."
msgid_plural "%u of them run under your account."
msgstr[0] "%u av dem kjører under kontoen din."
msgstr[1] "%u av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:284
msgid "The firewall check shows whether they can be reached."
msgstr "Brannmursjekken viser om de kan nås."

#: src/gui/gaudit-window.c:286
msgid "Network services"
msgstr "Nettverkstjenester"

#: src/gui/gaudit-window.c:290
msgid "Could not find out where security updates come from"
msgstr "Fant ikke ut hvor sikkerhetsoppdateringene kommer fra"

#: src/gui/gaudit-window.c:292
msgid "Security updates come directly from the distribution"
msgstr "Sikkerhetsoppdateringene kommer direkte fra distribusjonen"

#. Translators: %s is a host name, e.g. no.archive.ubuntu.com.
#: src/gui/gaudit-window.c:295
#, c-format
msgid "Security updates come from %s, a mirror that may lag behind"
msgstr "Sikkerhetsoppdateringene kommer fra %s, et speil som kan ligge etter"

#: src/gui/gaudit-window.c:297
msgid "Source of security updates"
msgstr "Kilde for sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:301
msgid "Could not check the private files"
