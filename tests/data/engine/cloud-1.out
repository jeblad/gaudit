(report (verdict warning) (title (msgn "{n} cloud program logs in in a way that is not documented" "{n} cloud programs log in in a way that is not documented" 1 (n 1))) (description (msg "What is in a cloud folder leaves the computer and is kept by someone else. Best is when it is encrypted before it leaves, so the provider cannot read it, under a law that protects privacy, with a program whose source code is open and that the system keeps up to date.")))
(home (verdict warning) (title (text "Dropbox")) (subtitle (msg "The provider can read what is sent there")))
(home (verdict warning) (title (msg "{service} through {client}" (service (text "Google Drive")) (client (text "Insync")))) (subtitle (msg "Where its login is made, and who keeps it, is not documented")))
(home (verdict warning) (title (text "pCloud")) (subtitle (msg "The provider can read what is sent there")))
(section (title (msg "Cloud Services on This Computer")) (description (msg "Programs that keep a copy of your files in a cloud service, and what is known about each.")))
(row (verdict warning) (title (text "Dropbox")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "{path}" (path "~/Cloud/Dropbox"))) (encryption (msg "the provider can read it")) (law (msg "under the law of the USA")))))
(row (verdict warning) (title (msg "{service} through {client}" (service (text "Google Drive")) (client (text "Insync")))) (subtitle (msg "{where} · where its login is made, and who keeps it, is not documented" (where (msg "{path}" (path "~/Insync/me@example.com/Google Drive"))))))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Google Drive")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "set up as {name}, without a folder of its own" (name "gdrive"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under the law of the USA")))))
(row (verdict warning) (title (text "pCloud")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/pCloudDrive"))) (encryption (msg "the provider can read it, except in a paid encrypted folder")) (law (msg "under Swiss law")))))
(row (verdict ok) (title (text "Tresorit")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "installed; where its folder is cannot be seen")) (encryption (msg "encrypted before it leaves the computer")) (law (msg "under Swiss law")))))
(section (title (msg "Mounted at Login")) (description (msg "Services that mount a cloud folder each time you log in.")))
(row (verdict advice) (title (msg "Nothing mounts {service} at login" (service (text "Google Drive")))) (subtitle (msg "rclone reaches it as {name}. Mounted by hand, the folder is empty after each login until it is mounted again, and what is put there meanwhile stays on this computer." (name "gdrive"))))
(section (title (msg "Where the Cloud Folders Are")) (description (msg "Cloud folders gathered under one folder, such as ~/Cloud, give one place to see what leaves the computer.")))
(row (verdict advice) (title (msgn "{n} cloud folder is not gathered with the others" "{n} cloud folders are not gathered with the others" 2 (n 2))) (subtitle (msg "Move each in its own program's settings, never in the file manager")))
(note (msg "A cloud folder is moved in its own program's settings. Moved in the file manager, the program may take your files as deleted, and delete them from the service and every computer that syncs it."))
(note (msg "Encryption with rclone keeps what is in the files, and what they are called, private. The service still sees how large each file is, when it was changed and uploaded, and how many files and folders there are. It also sees that they are encrypted: it keeps them private, but does not hide that they are there."))
