<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: GPL-3.0-only -->
<schemalist>
  <schema id="@GAUDIT_APP_ID@" path="/@GAUDIT_SCHEMA_PATH@/">
    <key name="window-width" type="i">
      <default>900</default>
      <summary>Window width</summary>
    </key>
    <key name="window-height" type="i">
      <default>600</default>
      <summary>Window height</summary>
    </key>
    <key name="window-maximized" type="b">
      <default>false</default>
      <summary>Window maximized</summary>
    </key>
    <!-- Home's report level. dconf is writable by the user (and by malware
         on the account), so Home always shows the level it runs at. -->
    <key name="home-level" type="s">
      <choices>
        <choice value="quick"/>
        <choice value="normal"/>
        <choice value="thorough"/>
      </choices>
      <default>"quick"</default>
      <summary>Report level on Home</summary>
    </key>
  </schema>
  <!-- A plugin's parameters, relocatable: one path per plugin and report,
       /@GAUDIT_SCHEMA_PATH@/plugins/<plugin-id>/<report-id>/. Plugins never
       install schemas of their own. Values are checked when read; dconf is
       writable by the account, so a report always says what it covered. -->
  <schema id="@GAUDIT_APP_ID@.plugin">
    <key name="folders" type="as">
      <default>[]</default>
      <summary>Folders searched besides the home folder</summary>
    </key>
    <!-- Places from the file manager the user took off the list; they are
         offered there again only if the user adds them back. -->
    <key name="removed-places" type="as">
      <default>[]</default>
      <summary>File manager places not searched</summary>
    </key>
  </schema>
</schemalist>
