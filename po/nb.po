#: src/gui/gaudit-app.c:66
msgid "General"
msgstr "Generelt"

#: src/gui/gaudit-app.c:69
msgid "There is nothing to set yet."
msgstr "Det er ingenting å stille inn ennå."

#: src/gui/gaudit-app.c:81
msgid "Open Main Menu"
msgstr "Åpne hovedmenyen"

#: src/gui/gaudit-app.c:82
msgid "Preferences"
msgstr "Innstillinger"

#: src/gui/gaudit-app.c:83
msgid "Keyboard Shortcuts"
msgstr "Tastatursnarveier"

#: src/gui/gaudit-app.c:84
msgid "Quit"
msgstr "Avslutt"

#: src/gui/gaudit-app.c:97 data/gaudit.desktop.in:6
msgid "Check the security status of this computer"
msgstr "Sjekk sikkerhetstilstanden på denne datamaskinen"

#. Translators: Replace with your names, one per line.
#: src/gui/gaudit-app.c:104
msgid "translator-credits"
msgstr ""

#: src/gui/gaudit-window.c:35
msgid "No checks have been run"
msgstr "Ingen sjekker er kjørt"

#: src/gui/gaudit-window.c:41
msgid "No signs of problems found"
msgstr "Fant ingen tegn til problemer"

#. Translators: Keep the meaning: a clean result is not a guarantee.
#: src/gui/gaudit-window.c:43
msgid ""
"This does not prove the computer is safe, only that the checks found nothing "
"wrong."
msgstr ""
"Dette beviser ikke at datamaskinen er trygg, bare at sjekkene ikke fant noe "
"galt."

#: src/gui/gaudit-window.c:48
msgid "Some things need attention"
msgstr "Noe trenger oppmerksomhet"

#: src/gui/gaudit-window.c:53
msgid "Serious problems found"
msgstr "Fant alvorlige problemer"

#: src/gui/gaudit-window.c:59
msgid "Some checks could not be completed"
msgstr "Noen sjekker kunne ikke fullføres"

#: src/gui/gaudit-window.c:78
msgid "OK"
msgstr "OK"

#: src/gui/gaudit-window.c:81
msgid "Needs attention"
msgstr "Trenger oppmerksomhet"

#: src/gui/gaudit-window.c:84
msgid "Serious"
msgstr "Alvorlig"

#: src/gui/gaudit-window.c:88 src/gui/gaudit-window.c:264
msgid "Unknown"
msgstr "Ukjent"

#: src/gui/gaudit-window.c:106
msgid "Not supported on this system yet"
msgstr "Støttes ikke på dette systemet ennå"

#: src/gui/gaudit-window.c:112
msgid "An antivirus program is installed"
msgstr "Et antivirusprogram er installert"

#: src/gui/gaudit-window.c:113
msgid "No antivirus program found"
msgstr "Fant ikke noe antivirusprogram"

#: src/gui/gaudit-window.c:114
msgid "Antivirus"
msgstr "Antivirus"

#: src/gui/gaudit-window.c:118
msgid "A firewall is installed"
msgstr "En brannmur er installert"

#: src/gui/gaudit-window.c:119
msgid "No firewall found"
msgstr "Fant ingen brannmur"

#: src/gui/gaudit-window.c:120
msgid "Firewall"
msgstr "Brannmur"

#: src/gui/gaudit-window.c:126
msgid "Could not find out when updates were last checked for"
msgstr "Fant ikke ut når det sist ble sett etter oppdateringer"

#: src/gui/gaudit-window.c:130
msgid "Last checked today"
msgstr "Sist sjekket i dag"

#: src/gui/gaudit-window.c:132
#, c-format
msgid "Last checked %d day ago"
msgid_plural "Last checked %d days ago"
msgstr[0] "Sist sjekket for %d dag siden"
msgstr[1] "Sist sjekket for %d dager siden"

#: src/gui/gaudit-window.c:137
msgid "Checking for updates"
msgstr "Se etter oppdateringer"

#: src/gui/gaudit-window.c:141
msgid "Could not find out whether updates are waiting"
msgstr "Fant ikke ut om det venter oppdateringer"

#: src/gui/gaudit-window.c:143
msgid "No updates are waiting"
msgstr "Ingen oppdateringer venter"

#: src/gui/gaudit-window.c:145
#, c-format
msgid "%u update is waiting to be installed"
msgid_plural "%u updates are waiting to be installed"
msgstr[0] "%u oppdatering venter på å bli installert"
msgstr[1] "%u oppdateringer venter på å bli installert"

#: src/gui/gaudit-window.c:149
msgid "Pending updates"
msgstr "Ventende oppdateringer"

#: src/gui/gaudit-window.c:153
msgid "Could not find out where the installed packages come from"
msgstr "Fant ikke ut hvor de installerte pakkene kommer fra"

#: src/gui/gaudit-window.c:155
msgid "All packages come from a software source"
msgstr "Alle pakker kommer fra en programvarekilde"

#: src/gui/gaudit-window.c:157
#, c-format
msgid "%u package is no longer offered by any software source"
msgid_plural "%u packages are no longer offered by any software source"
msgstr[0] "%u pakke tilbys ikke lenger av noen programvarekilde"
msgstr[1] "%u pakker tilbys ikke lenger av noen programvarekilde"

#: src/gui/gaudit-window.c:161
msgid "Packages without a source"
msgstr "Pakker uten kilde"

#: src/gui/gaudit-window.c:165
msgid "Updates are installed automatically"
msgstr "Oppdateringer installeres automatisk"

#: src/gui/gaudit-window.c:167
msgid "Automatic updates are switched off"
msgstr "Automatiske oppdateringer er slått av"

#: src/gui/gaudit-window.c:168
msgid "Could not find out whether automatic updates are switched on"
msgstr "Fant ikke ut om automatiske oppdateringer er slått på"

#: src/gui/gaudit-window.c:169
msgid "Automatic updates"
msgstr "Automatiske oppdateringer"

#: src/gui/gaudit-window.c:173
msgid "Software needed to check Flatpak apps is missing"
msgstr "Programvare som trengs for å sjekke Flatpak-apper, mangler"

#: src/gui/gaudit-window.c:175
msgid "Could not check the Flatpak apps"
msgstr "Kunne ikke sjekke Flatpak-appene"

#: src/gui/gaudit-window.c:177
msgid "No apps use runtimes without security updates"
msgstr "Ingen apper bruker runtimes uten sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:182
#, c-format
msgid "%u app uses a runtime without security updates"
msgid_plural "%u apps use runtimes without security updates"
msgstr[0] "%u app bruker en runtime uten sikkerhetsoppdateringer"
msgstr[1] "%u apper bruker runtimes uten sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:187
#, c-format
msgid "%u unused outdated runtime can be removed"
msgid_plural "%u unused outdated runtimes can be removed"
msgstr[0] "%u ubrukt, utdatert runtime kan fjernes"
msgstr[1] "%u ubrukte, utdaterte runtimes kan fjernes"

#: src/gui/gaudit-window.c:192
#, c-format
msgid "%u outdated runtime is kept but not used by any app"
msgid_plural "%u outdated runtimes are kept but not used by any app"
msgstr[0] "%u utdatert runtime er beholdt, men brukes ikke av noen app"
msgstr[1] "%u utdaterte runtimes er beholdt, men brukes ikke av noen app"

#: src/gui/gaudit-window.c:207
msgid "Flatpak apps"
msgstr "Flatpak-apper"

#: src/gui/gaudit-window.c:259
msgid "Debian"
msgstr "Debian"

#: src/gui/gaudit-window.c:260
msgid "generic"
msgstr "generell"

#: src/gui/gaudit-window.c:263
#, c-format
msgid "%s – %s"
msgstr "%s – %s"

#. Translators: "Status: <host name> (<system>)".
#: src/gui/gaudit-window.c:266
#, c-format
msgid "Status: %s (%s)"
msgstr "Status: %s (%s)"

#: src/gui/gaudit-window.c:267
msgid "this computer"
msgstr "denne datamaskinen"

#: src/gui/gaudit-window.c:281
msgid "A quick look that does not need your password."
msgstr "En rask titt som ikke krever passordet ditt."

#: src/gui/gaudit-window.c:313
msgid "Checks"
msgstr "Sjekker"

#: src/gui/gaudit-window.c:317 src/gui/gaudit-task-page.c:190
msgid "Not available on this system"
msgstr "Ikke tilgjengelig på dette systemet"

#: src/gui/gaudit-window.c:318 src/gui/gaudit-task-page.c:124
msgid "Software is missing"
msgstr "Programvare mangler"

#: src/gui/gaudit-window.c:319
msgid "Not run yet"
msgstr "Ikke kjørt ennå"

#: src/gui/gaudit-window.c:338 src/gui/gaudit-window.c:447
msgid "Home"
msgstr "Hjem"

#: src/gui/gaudit-window.c:407
msgid "_Preferences"
msgstr "_Innstillinger"

#: src/gui/gaudit-window.c:408
msgid "_Keyboard Shortcuts"
msgstr "_Tastatursnarveier"

#. Translators: %s is the application name, which is not translated.
#: src/gui/gaudit-window.c:410
#, c-format
msgid "_About %s"
msgstr "_Om %s"

#: src/gui/gaudit-window.c:421
msgid "Main Menu"
msgstr "Hovedmeny"

#: src/gui/gaudit-window.c:447
msgid "Overall status"
msgstr "Samlet status"

#: src/gui/gaudit-task-page.c:46
msgid "Check started"
msgstr "Sjekken er startet"

#: src/gui/gaudit-task-page.c:47
msgid "Running checks is not implemented yet."
msgstr "Kjøring av sjekker er ikke implementert ennå."

#: src/gui/gaudit-task-page.c:62
msgid "More about this"
msgstr "Mer om dette"

#: src/gui/gaudit-task-page.c:73
msgid "What to check"
msgstr "Hva som skal sjekkes"

#: src/gui/gaudit-task-page.c:86
msgid "Start"
msgstr "Start"

#: src/gui/gaudit-task-page.c:104
msgid "Command copied"
msgstr "Kommandoen er kopiert"

#: src/gui/gaudit-task-page.c:112
msgid "Installing is not implemented yet."
msgstr "Installering er ikke implementert ennå."

#: src/gui/gaudit-task-page.c:127
#, c-format
msgid "This check needs software that is not installed: %s."
msgstr "Denne sjekken trenger programvare som ikke er installert: %s."

#: src/gui/gaudit-task-page.c:133
msgid ""
"You can install it with the button below, or copy this command and run it in "
"a terminal yourself:"
msgstr ""
"Du kan installere den med knappen nedenfor, eller kopiere denne kommandoen "
"og kjøre den i en terminal selv:"

#: src/gui/gaudit-task-page.c:156 src/gui/gaudit-task-page.c:158
msgid "Copy command"
msgstr "Kopier kommandoen"

#: src/gui/gaudit-task-page.c:164
msgid "Install"
msgstr "Installer"

#: src/gui/gaudit-task-page.c:172
msgid ""
"Installing uses the system's software service and asks for your password."
msgstr ""
"Installeringen bruker systemets programvaretjeneste og ber om passordet ditt."

#: src/gui/gaudit-task-page.c:192
msgid "This check is not supported on this operating system yet."
msgstr "Denne sjekken støttes ikke på dette operativsystemet ennå."

#. Translators: Application name. Do not translate.
#: data/gaudit.desktop.in:4
msgid "gAudit"
msgstr ""

#: data/gaudit.desktop.in:5
msgid "Security Audit"
msgstr "Sikkerhetssjekk"

#: data/gaudit.desktop.in:7
msgid "security;audit;antivirus;firewall;updates;"
msgstr "sikkerhet;revisjon;antivirus;brannmur;oppdateringer;security;audit;firewall;updates;"

#: data/gaudit.policy.in:8
msgid "Run privileged security checks"
msgstr "Kjør sikkerhetssjekker med utvidede rettigheter"

#: data/gaudit.policy.in:9
msgid ""
"Authentication is required to check the security status of this computer"
msgstr ""
"Autentisering kreves for å sjekke sikkerhetstilstanden på denne datamaskinen"
