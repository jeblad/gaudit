(report (verdict warning) (title (msgn "{n} cloud service found" "{n} cloud services found" 2 (n 2))) (description (msg "What is in a cloud folder leaves the computer and is kept by someone else. Best is when it is encrypted before it leaves, so the provider cannot read it, under a law that protects privacy, with a program whose source code is open and that the system keeps up to date.")))
(home (verdict warning) (title (msgn "{n} file or folder at {service} is not encrypted" "{n} files and folders at {service} are not encrypted" 3 (n 3) (service (text "Dropbox")))) (subtitle (msg "The provider can read them")))
(section (title (msg "Cloud Services on This Computer")) (description (msg "Programs that keep a copy of your files in a cloud service, and what is known about each.")))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Dropbox")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/Cloud/Dropbox"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under the law of the USA")))))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Jottacloud")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/Cloud/Jottacloud"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under Norwegian law")))))
(section (title (msg "Mounted at Login")) (description (msg "Services that mount a cloud folder each time you log in.")))
(row (verdict ok) (title (msg "{path} is mounted at each login" (path "~/Cloud/Dropbox"))) (subtitle (msg "By {file}" (file "rclone-dropbox-private.service"))))
(row (verdict ok) (title (msg "{path} is mounted at each login" (path "~/Cloud/Jottacloud"))) (subtitle (msg "By {file}" (file "rclone-jottacloud.service"))))
(section (title (msg "Files Not Encrypted")) (description (msg "Files at a service outside its encrypted folder, which the provider can read. Looking for them asks the service, so it is done only when you ask, on its page.")))
(row (verdict warning) (title (msgn "{n} file or folder at {service} is not encrypted" "{n} files and folders at {service} are not encrypted" 3 (n 3) (service (text "Dropbox")))) (subtitle (msg "The provider can read them · set up the shareable disk, to share them or to move them to the private one")) (fix plain (item 0)))
(row (verdict ok) (title (msg "Everything at {service} is in the encrypted folder" (service (text "Jottacloud")))) (subtitle (msg "The provider sees only that encrypted files are there")) (fix plain (item 1)))
(section (title (msg "Secrets in Cloud Folders")) (description (msg "Files that look like secrets, such as keys and stored logins, where a cloud service gets them. The folders kept on this computer are searched; at a service reached through rclone, only the names are looked at, when you ask.")))
(row (verdict advice) (title (msg "Names at {service} are not looked at for secrets" (service (text "Dropbox")))) (subtitle (msg "Looking asks the service, so it is done only when you ask")) (fix names (item 0)))
(row (verdict advice) (title (msg "Names at {service} are not looked at for secrets" (service (text "Jottacloud")))) (subtitle (msg "Looking asks the service, so it is done only when you ask")) (fix names (item 1)))
(note (msg "A cloud folder is moved in its own program's settings. Moved in the file manager, the program may take your files as deleted, and delete them from the service and every computer that syncs it."))
(note (msg "Encryption with rclone keeps what is in the files, and what they are called, private. The service still sees how large each file is, when it was changed and uploaded, and how many files and folders there are. It also sees that they are encrypted: it keeps them private, but does not hide that they are there."))
