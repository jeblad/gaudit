(report (verdict warning) (title (msgn "{n} problem with updates" "{n} problems with updates" 1 (n 1))) (description (msg "Open each one marked with a warning to see what to do about it.")))
(home (verdict warning) (title (msgn "{n} package gets no updates" "{n} packages get no updates" 1 (n 1))) (subtitle (msg "No software source offers them")))
(section (title (msg "Status now")) (description (msg "What is waiting to be installed on this computer.")))
(row (verdict ok) (title (msg "No security updates are waiting")) (subtitle (msg "Looked for {when}" (when (msgn "{n} hour ago" "{n} hours ago" 8 (n 8))))))
(section (title (msg "Keeps itself up to date")) (description (msg "Whether this computer looks for updates and installs them by itself.")))
(row (verdict ok) (title (msg "Updates are looked for every day")) (subtitle (msg "Set up as it should be")))
(row (verdict ok) (title (msg "Updates are installed automatically")) (subtitle (msg "Last run {when}" (when (msgn "{n} hour ago" "{n} hours ago" 8 (n 8))))))
(section (title (msg "Where updates come from")) (description (msg "Security updates should come straight from the distribution, and every installed package from a software source.")))
(row (verdict ok) (title (msg "Security updates come from the distribution itself")) (subtitle (msg "Not from a mirror that may lag behind")))
(row (verdict warning) (title (msgn "{n} package probably comes from other places" "{n} packages probably come from other places" 1 (n 1))) (subtitle (msg "Such as a downloaded package or a source no longer set up")) (fix sourceless (item 15)))
(row (verdict advice) (title (msgn "{n} package is an update from {release}, kept at the upgrade" "{n} packages are updates from {release}, kept at the upgrade" 2 (n 2) (release "Ubuntu 26.04"))) (subtitle (msg "This release's own version is older, so it stays until this release passes it")) (fix sourceless (item 17)))
(section (title (msg "Programs you update yourself")) (description (msg "Their makers offer them only as a download, or as a copy of a software source that never changes, so the system never updates them: new versions come from the maker.")))
(row (verdict advice) (title (msg "{title} gets no updates from the system" (title "Zoom"))) (subtitle (msg "Version {version} · {vendor} offers it only as a download, without a software source" (version "7.2.5.6661") (vendor "Zoom"))) (fix vendor (item 20)))
