(section (title (msg "Keeps itself up to date")) (description (msg "Whether this computer looks for updates and installs them by itself.")))
(row (verdict warning) (title (msg "Updates are never looked for")) (subtitle (msg "Nothing new is found, security updates included")) (fix check-on (item 3)))
(row (verdict advice) (title (msg "Updates are not installed automatically")) (subtitle (msg "Recommended: let them install by themselves, unless there is a reason not to")) (fix automatic-on (item 4)))
