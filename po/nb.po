msgstr "Arch"

#: src/gui/gaudit-window.c:631
msgid "generic"
msgstr "generell"

#: src/gui/gaudit-window.c:634
#, c-format
msgid "%s – %s"
msgstr "%s – %s"

#. Translators: "Status: <host name> (<system>)".
#: src/gui/gaudit-window.c:637
#, c-format
msgid "Status: %s (%s)"
msgstr "Status: %s (%s)"

#: src/gui/gaudit-window.c:638
msgid "this computer"
msgstr "denne datamaskinen"

#: src/gui/gaudit-window.c:652
msgid "A quick look that does not need your password."
msgstr "En rask titt som ikke krever passordet ditt."

#: src/gui/gaudit-window.c:677
msgid "Checks"
