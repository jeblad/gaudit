(report (verdict warning) (title (msgn "{n} folder is shared on the local network" "{n} folders are shared on the local network" 2 (n 2))) (description (msg "What is shared is best kept in one folder, so it is clear what others on the network can read. A folder that looks like the shared folder is a recommendation: it may be kept on purpose.")))
(home (verdict warning) (title (msgn "{n} secret is in a folder shared on the local network" "{n} secrets are in folders shared on the local network" 2 (n 2))) (subtitle (msg "Move them into a folder of your own")))
(home (verdict warning) (title (msgn "{n} folder is shared on the local network" "{n} folders are shared on the local network" 2 (n 2))) (subtitle (msg "Check that the sharing is meant")))
(section (title (msg "The Folder for Sharing")) (description (msg "The one your desktop uses for what you share with others on the local network.")))
(row (verdict ok) (title (text "~/Offentlig")) (subtitle (msg "The folder for sharing, set in your user folder settings")))
(section (title (msg "Folders That Look Like It")) (description (msg "Their names are ones the folder for sharing has had, in another language or an older version. Two such folders make it unclear which one is shared.")))
(row (verdict advice) (title (text "~/Public")) (subtitle (msg "The {lang} name · {contents}" (lang (msg "English")) (contents (msg "on another disk or a network folder, not looked in")))) (fix tidy (item 2)))
(section (title (msg "Shared on the Local Network")) (description (msg "Others on the same network can read what is in these folders, at home or on a café's Wi-Fi.")))
(row (verdict warning) (title (text "~/Offentlig")) (subtitle (msg "Shared by GNOME Sharing, which is running")))
(row (verdict warning) (title (text "~/Bilder")) (subtitle (msg "Shared from the file manager (Samba) as {name}" (name "Bilder"))))
(section (title (msg "Secrets in Folders for Sharing")) (description (msg "Files that look like secrets, such as keys and stored logins, put in a folder for sharing, often by mistake. What a service shares, others on the local network can fetch.")))
(row (verdict warning) (title (text "~/Offentlig/id_rsa")) (subtitle (msg "{kind} · {why}" (kind (msg "SSH private key")) (why (msg "GNOME Sharing shares it on the local network")))) (fix secret-shared (item 5)))
(row (verdict warning) (title (text "~/Offentlig/old/vault.kdbx")) (subtitle (msg "{kind} · {why}" (kind (msg "KeePass password database")) (why (msg "GNOME Sharing shares it on the local network")))) (fix secret-shared (item 6)))
(note (msgn "{n} folder was not searched: it is on another disk or a network folder, or a link, and looking in it may fetch it over the network." "{n} folders were not searched: they are on another disk or a network folder, or links, and looking in them may fetch them over the network." 1 (n 1)))
(note (msg "Other folders a service shares are searched for secrets in the full report, and on Home at the Thorough level."))
