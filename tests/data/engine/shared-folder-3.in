(input (system (host "h") (distro "Ubuntu 26.10") (backend "debian"))
 (level "quick")
 (collection
  (shared-config (state 1) (standard "~/Offentlig") (exists 1) (locale "nb_NO") (default "Public") (names 95))
  (shared-folder (name "Offentlig") (lang "nb") (machine 1) (current 1) (standard 1) (link 0) (target "") (case 0) (entries 2))
  (shared-folder (name "Public") (lang "") (machine 1) (current 1) (standard 0) (link 0) (target "") (case 0) (entries -2))
  (shared-service (kind "gnome") (name "gnome-user-share") (path "~/Offentlig"))
  (shared-service (kind "samba-user") (name "Bilder") (path "~/Bilder"))
  (shared-secret (path "~/Offentlig/id_rsa") (reason "openssh-private-key") (by "gnome"))
  (shared-secret (path "~/Offentlig/old/vault.kdbx") (reason "keepass") (by "gnome"))
  (shared-secret-scan (folders 1) (skipped 1) (found 2) (more 0) (truncated 0))
  (shared-end (folders 2) (services 2) (more 0) (usershares 0))))
