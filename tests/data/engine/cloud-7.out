(report (verdict warning) (title (msgn "{n} cloud service where the provider can read your files" "{n} cloud services where the provider can read your files" 2 (n 2))) (description (msg "What is in a cloud folder leaves the computer and is kept by someone else. Best is when it is encrypted before it leaves, so the provider cannot read it, under a law that protects privacy, with a program whose source code is open and that the system keeps up to date.")))
(home (verdict warning) (title (msgn "{n} secret in a cloud folder the provider can read" "{n} secrets in cloud folders the provider can read" 1 (n 1))) (subtitle (msg "Move them out, or to the private disk")))
(home (verdict warning) (title (msgn "{n} secret in a cloud folder where it is unclear who can read it" "{n} secrets in cloud folders where it is unclear who can read them" 2 (n 2))) (subtitle (msg "Find out whether the folder is encrypted before it leaves")))
(home (verdict warning) (title (text "Dropbox")) (subtitle (msg "The provider can read what is sent there")))
(home (verdict warning) (title (text "Nextcloud")) (subtitle (msg "The provider can read what is sent there")))
(section (title (msg "Cloud Services on This Computer")) (description (msg "Programs that keep a copy of your files in a cloud service, and what is known about each.")))
(row (verdict warning) (title (text "Dropbox")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "{path}" (path "~/Cloud/Dropbox"))) (encryption (msg "the provider can read it")) (law (msg "under the law of the USA")))))
(row (verdict warning) (title (text "Nextcloud")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "{path}" (path "~/Cloud/Nextcloud"))) (encryption (msg "the provider can read it unless a folder is set to be encrypted")) (law (msg "under the law where its server is")))))
(row (verdict ok) (title (text "MEGA")) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "probably {path}, its usual folder" (path "~/MEGA"))) (encryption (msg "encrypted before it leaves the computer")) (law (msg "under the law of New Zealand")))))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Jottacloud")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/Cloud/Jottacloud (privat)"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under Norwegian law")))))
(section (title (msg "Mounted at Login")) (description (msg "Services that mount a cloud folder each time you log in.")))
(row (verdict advice) (title (msg "Nothing mounts {service} at login" (service (text "Jottacloud")))) (subtitle (msg "rclone reaches it as {name}. Mounted by hand, the folder is empty after each login until it is mounted again, and what is put there meanwhile stays on this computer. Set Up With rclone can make a service that mounts it at each login." (name "jotta"))))
(section (title (msg "Files Not Encrypted")) (description (msg "Files at a service outside its encrypted folder, which the provider can read. Looking for them asks the service, so it is done only when you ask, on its page.")))
(row (verdict advice) (title (msg "Unencrypted files at {service} are not looked for" (service (text "Jottacloud")))) (subtitle (msg "Only the private disk is set up here · looking asks the service, so it is done only when you ask")) (fix plain (item 3)))
(section (title (msg "Secrets in Cloud Folders")) (description (msg "Files that look like secrets, such as keys and stored logins, where a cloud service gets them. The folders kept on this computer are searched; at a service reached through rclone, only the names are looked at, when you ask.")))
(row (verdict warning) (title (text "~/Cloud/Dropbox/.netrc")) (subtitle (msg "{kind} · {why}" (kind (msg "Stored logins (.netrc)")) (why (msg "the provider can read it")))) (fix secret-readable (item 4)))
(row (verdict advice) (title (text "~/Cloud/Dropbox/vault.kdbx")) (subtitle (msg "{kind} · {why}" (kind (msg "KeePass password database")) (why (msg "encrypted with its own password; move it to the private disk")))) (fix secret-own (item 5)))
(row (verdict warning) (title (text "~/Cloud/Nextcloud/.git-credentials")) (subtitle (msg "{kind} · {why}" (kind (msg "Git passwords")) (why (msg "whether the provider can read it is not clear")))) (fix secret-unclear (item 6)))
(row (verdict warning) (title (msg "{service}: {path}" (service (text "Jottacloud")) (path (text "old/id_ed25519")))) (subtitle (msg "{kind} · {why}" (kind (msg "probably an SSH private key, by its name")) (why (msg "whether the provider can read it is not clear")))) (fix secret-unclear (item 9)))
(row (verdict warning) (title (msgn "{n} name at {service} looks like a secret" "{n} names at {service} look like secrets" 1 (n 1) (service (text "Jottacloud")))) (subtitle (msgn "Of {n} name looked at, outside the encrypted folder" "Of {n} names looked at, outside the encrypted folder" 812 (n 812))) (fix names (item 3)))
(note (msg "A file known by its name alone may not be what its name says: an id_ed25519 may be empty, and a .pem may hold only a certificate. Only its content can tell."))
(note (msg "A cloud folder is moved in its own program's settings. Moved in the file manager, the program may take your files as deleted, and delete them from the service and every computer that syncs it."))
(note (msg "Encryption with rclone keeps what is in the files, and what they are called, private. The service still sees how large each file is, when it was changed and uploaded, and how many files and folders there are. It also sees that they are encrypted: it keeps them private, but does not hide that they are there."))
