(input (system (host "h") (distro "Ubuntu 26.10") (backend "debian"))
 (level "quick")
 (collection
  (shared-config (state 1) (standard "~/Offentlig") (exists 1) (locale "nb_NO") (default "Public") (names 95))
  (shared-folder (name "Offentlig") (lang "nb") (machine 1) (current 1) (standard 1) (link 0) (target "") (case 0) (entries 2))
  (shared-service (kind "gnome") (name "gnome-user-share-webdav") (path "/home/u/Offentlig"))
  (shared-service (kind "samba-user") (name "Bilder") (path "/home/u/Bilder"))
  (shared-end (folders 1) (services 2) (more 0) (usershares 1))))
