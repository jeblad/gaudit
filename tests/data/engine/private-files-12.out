(report (verdict warning) (title (msgn "{n} secret can be read by others" "{n} secrets can be read by others" 3 (n 3))) (description (msg "Anyone who can use these accounts can copy them. Open each one marked with a warning to see how to close it.")))
(home (verdict warning) (title (msgn "{n} secret can be read by every account" "{n} secrets can be read by every account" 3 (n 3))) (subtitle (msg "Any other account on this computer can copy them")))
(section (title (msg "Every account can read these")) (description (msg "Any other account on this computer can read them, including programs running as those accounts.")))
(row (verdict warning) (title (text "~/a.kdbx")) (subtitle (msg "{kind} · {mode}" (kind (msg "KeePass password database")) (mode "0644"))) (fix make-private (item 1)))
(note (msg "Showing {shown} of the {count} secrets found. Some that others can read are not shown: fix these first, then check again." (shown 1) (count 5)))
