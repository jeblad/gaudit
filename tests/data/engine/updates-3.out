(report (verdict warning) (title (msgn "{n} problem with updates" "{n} problems with updates" 1 (n 1))) (description (msg "Open each one marked with a warning to see what to do about it.")))
(home (verdict unknown) (title (msg "How often updates are looked for")) (subtitle (msg "Not supported on this system yet")))
(home (verdict unknown) (title (msg "When updates were last looked for")) (subtitle (msg "Could not be found out")))
(home (verdict unknown) (title (msg "Whether updates are installed automatically")) (subtitle (msg "Not supported on this system yet")))
(home (verdict warning) (title (msgn "{n} package gets no updates" "{n} packages get no updates" 2 (n 2))) (subtitle (msg "No software source offers them")))
(section (title (msg "Looking for updates")) (description (msg "New updates are only found when this computer looks for them.")))
(row (verdict unknown) (title (msg "How often updates are looked for")) (subtitle (msg "Not supported on this system yet")))
(row (verdict unknown) (title (msg "When updates were last looked for")) (subtitle (msg "Could not be found out")))
(section (title (msg "Installing updates")) (description (msg "Updates help only once they are installed. Security updates matter most.")))
(row (verdict ok) (title (msg "No updates are waiting")) (subtitle (msg "As far as the last look for updates knows")))
(row (verdict unknown) (title (msg "Whether updates are installed automatically")) (subtitle (msg "Not supported on this system yet")))
(section (title (msg "Software no source keeps up to date")) (description (msg "Installed packages that no software source offers get no updates.")))
(row (verdict warning) (title (msgn "{n} package probably comes from other places" "{n} packages probably come from other places" 2 (n 2))) (subtitle (msg "Such as a downloaded package or a source no longer set up")) (fix sourceless (item 15)))
