(report (verdict warning) (title (msgn "{n} problem with updates" "{n} problems with updates" 1 (n 1))) (description (msg "Open each one marked with a warning to see what to do about it.")))
(home (verdict warning) (title (msgn "{n} other update is waiting" "{n} other updates are waiting" 4 (n 4))) (subtitle (msgn "Nothing has been installed for {days} day, and nothing installs them automatically" "Nothing has been installed for {days} days, and nothing installs them automatically" 21 (days 21))))
(section (title (msg "Looking for updates")) (description (msg "New updates are only found when this computer looks for them.")))
(row (verdict ok) (title (msg "Updates are looked for every day")) (subtitle (msg "Set up as it should be")))
(row (verdict ok) (title (msg "Updates were last looked for {when}" (when (msgn "{n} hour ago" "{n} hours ago" 8 (n 8))))) (subtitle (msg "Recently enough")))
(section (title (msg "Installing updates")) (description (msg "Updates help only once they are installed. Security updates matter most.")))
(row (verdict ok) (title (msg "No security updates are waiting")) (subtitle (msg "As far as the last look for updates knows")))
(row (verdict warning) (title (msgn "{n} other update is waiting" "{n} other updates are waiting" 4 (n 4))) (subtitle (msgn "Nothing has been installed for {days} day, and nothing installs them automatically" "Nothing has been installed for {days} days, and nothing installs them automatically" 21 (days 21))) (fix install-now (item 11)))
(row (verdict advice) (title (msg "Updates are not installed automatically")) (subtitle (msg "Recommended: let them install by themselves, unless there is a reason not to")) (fix automatic-on (item 4)))
(section (title (msg "Where security updates come from")) (description (msg "Security updates should come straight from the distribution.")))
(row (verdict ok) (title (msg "Security updates come from the distribution itself")) (subtitle (msg "Not from a mirror that may lag behind")))
(section (title (msg "Software no source keeps up to date")) (description (msg "Installed packages that no software source offers get no updates.")))
(row (verdict ok) (title (msg "All installed packages come from a software source")) (subtitle (msg "So they get updates")))
