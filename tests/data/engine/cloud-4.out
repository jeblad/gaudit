(report (verdict ok) (title (msgn "{n} cloud service found" "{n} cloud services found" 1 (n 1))) (description (msg "What is in a cloud folder leaves the computer and is kept by someone else. Best is when it is encrypted before it leaves, so the provider cannot read it, under a law that protects privacy, with a program whose source code is open and that the system keeps up to date.")))
(home (verdict ok) (title (msgn "{n} cloud service found" "{n} cloud services found" 1 (n 1))) (subtitle (msg "Nothing needs attention")))
(section (title (msg "Cloud Services on This Computer")) (description (msg "Programs that keep a copy of your files in a cloud service, and what is known about each.")))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Jottacloud")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/Cloud/Jottacloud"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under Norwegian law")))))
(section (title (msg "Mounted at Login")) (description (msg "Services that mount a cloud folder each time you log in.")))
(row (verdict advice) (title (msg "Nothing mounts {service} at login" (service (text "Jottacloud")))) (subtitle (msg "rclone reaches it as {name}. Mounted by hand, the folder is empty after each login until it is mounted again, and what is put there meanwhile stays on this computer. Set Up With rclone can make a service that mounts it at each login." (name "jotta"))))
(section (title (msg "Files Not Encrypted")) (description (msg "Files at a service outside its encrypted folder, which the provider can read. Looking for them asks the service, so it is done only when you ask, on its page.")))
(row (verdict advice) (title (msg "Unencrypted files at {service} are not looked for" (service (text "Jottacloud")))) (subtitle (msg "Only the private disk is set up here · looking asks the service, so it is done only when you ask")) (fix plain (item 0)))
(note (msg "A cloud folder is moved in its own program's settings. Moved in the file manager, the program may take your files as deleted, and delete them from the service and every computer that syncs it."))
(note (msg "Encryption with rclone keeps what is in the files, and what they are called, private. The service still sees how large each file is, when it was changed and uploaded, and how many files and folders there are. It also sees that they are encrypted: it keeps them private, but does not hide that they are there."))
