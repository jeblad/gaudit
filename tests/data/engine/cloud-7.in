(input (system (host "h") (distro "Ubuntu 26.10") (backend "debian"))
 (level "full")
 (collection
  (cloud-folder (client "dropbox") (service "dropbox") (how 0) (path "~/Cloud/Dropbox") (name "") (encrypted 0) (via "") (gathered 1))
  (cloud-folder (client "nextcloud") (service "nextcloud") (how 0) (path "~/Cloud/Nextcloud") (name "") (encrypted 0) (via "") (gathered 1))
  (cloud-folder (client "megasync") (service "mega") (how 1) (path "~/MEGA") (name "") (encrypted 0) (via "") (gathered 0))
  (cloud-folder (client "rclone") (service "jottacloud") (how 3) (path "~/Cloud/Jottacloud (privat)") (name "jotta") (encrypted 1) (via "jotta-crypt") (gathered 1))
  (cloud-secret (service "dropbox") (remote "") (path "~/Cloud/Dropbox/.netrc") (reason "netrc") (by-name 0))
  (cloud-secret (service "dropbox") (remote "") (path "~/Cloud/Dropbox/vault.kdbx") (reason "keepass") (by-name 0))
  (cloud-secret (service "nextcloud") (remote "") (path "~/Cloud/Nextcloud/.git-credentials") (reason "git-credentials") (by-name 0))
  (cloud-secret (service "mega") (remote "") (path "~/MEGA/id_rsa") (reason "openssh-private-key") (by-name 0))
  (cloud-secret-scan (folders 3) (found 4) (more 0) (truncated 0))
  (cloud-secret (service "jottacloud") (remote "jotta") (path "old/id_ed25519") (reason "ssh-key-name") (by-name 1))
  (cloud-names (remote "jotta") (status 0) (looked 812) (found 1) (more 0) (truncated 0))
  (cloud-end (count 4) (more 0) (gathering "~/Cloud") (gatherings 1) (rclone-unreadable 0))))
