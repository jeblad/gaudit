(report (verdict warning) (title (msgn "{n} cloud service found" "{n} cloud services found" 1 (n 1))) (description (msg "What is in a cloud folder leaves the computer and is kept by someone else. Best is when it is encrypted before it leaves, so the provider cannot read it, under a law that protects privacy, with a program whose source code is open and that the system keeps up to date.")))
(home (verdict warning) (title (msg "{path} is not mounted" (path "~/Skytjenester/Dropbox (delt mappe)"))) (subtitle (msg "What is put there now stays on this computer, unencrypted")))
(section (title (msg "Cloud Services on This Computer")) (description (msg "Programs that keep a copy of your files in a cloud service, and what is known about each.")))
(row (verdict ok) (title (msg "{service} through {client}" (service (text "Dropbox")) (client (text "rclone")))) (subtitle (msg "{where} · {encryption} · {law}" (where (msg "mounted at {path}" (path "~/Skytjenester/Dropbox (privat)"))) (encryption (msg "contents and names encrypted before they leave the computer")) (law (msg "under the law of the USA")))))
(section (title (msg "Mounted at Login")) (description (msg "Services that mount a cloud folder each time you log in.")))
(row (verdict ok) (title (msg "{path} is mounted at each login" (path "~/Skytjenester/Dropbox (privat)"))) (subtitle (msg "By {file}" (file "rclone-dropbox-private.service"))))
(row (verdict warning) (title (msg "{path} is not mounted" (path "~/Skytjenester/Dropbox (delt mappe)"))) (subtitle (msg "Until it is, what is put there stays on this computer, unencrypted. Its service is {file}." (file "rclone-dropbox-shared.service"))))
(section (title (msg "Secrets in Cloud Folders")) (description (msg "Files that look like secrets, such as keys and stored logins, where a cloud service gets them. The folders kept on this computer are searched; at a service reached through rclone, only the names are looked at, when you ask.")))
(row (verdict advice) (title (msg "Names at {service} are not looked at for secrets" (service (text "Dropbox")))) (subtitle (msg "Looking asks the service, so it is done only when you ask")) (fix names (item 0)))
(note (msg "A cloud folder is moved in its own program's settings. Moved in the file manager, the program may take your files as deleted, and delete them from the service and every computer that syncs it."))
(note (msg "Encryption with rclone keeps what is in the files, and what they are called, private. The service still sees how large each file is, when it was changed and uploaded, and how many files and folders there are. It also sees that they are encrypted: it keeps them private, but does not hide that they are there."))
