msgstr "Grundig"

#: src/gui/gaudit-window.c:127 src/gui/gaudit-window.c:510
#: src/gui/gaudit-window.c:756
msgid "Checking…"
msgstr "Sjekker …"

#: src/gui/gaudit-window.c:128
msgid "Looking at the status of this computer."
msgstr "Ser på tilstanden til denne datamaskinen."

#: src/gui/gaudit-window.c:133
msgid "No signs of problems found"
msgstr "Fant ingen tegn til problemer"

#. Translators: Keep the meaning: a clean result is not a guarantee.
#: src/gui/gaudit-window.c:135
msgid ""
"This does not prove the computer is safe, only that the checks found nothing "
"wrong."
msgstr ""
"Dette beviser ikke at datamaskinen er trygg, bare at sjekkene ikke fant noe "
"galt."

#: src/gui/gaudit-window.c:140
msgid "Some things need attention"
msgstr "Noe trenger oppmerksomhet"

#: src/gui/gaudit-window.c:145
msgid "Serious problems found"
msgstr "Fant alvorlige problemer"

#: src/gui/gaudit-window.c:151
msgid "Some checks could not be completed"
msgstr "Noen sjekker kunne ikke fullføres"

#: src/gui/gaudit-window.c:187 src/gui/gaudit-sourceless-page.c:129
msgid "Not supported on this system yet"
msgstr "Støttes ikke på dette systemet ennå"

#. Translators: "This looks like Ubuntu, but its package system (dpkg/apt) was not found".
#: src/gui/gaudit-window.c:195
#, c-format
msgid "This looks like %s, but its package system (%s) was not found"
msgstr "Dette ser ut som %s, men pakkesystemet (%s) ble ikke funnet"

#: src/gui/gaudit-window.c:196
msgid "a known distribution"
msgstr "en kjent distribusjon"

#: src/gui/gaudit-window.c:198
msgid "Package system"
msgstr "Pakkesystem"

#: src/gui/gaudit-window.c:203
msgid "Software needed to check snaps is missing"
msgstr "Programvare som trengs for å sjekke snaps, mangler"

#: src/gui/gaudit-window.c:205
msgid "The snap service is not running, so snaps are not updated"
msgstr "Snap-tjenesten kjører ikke, så snaps blir ikke oppdatert"

#: src/gui/gaudit-window.c:207
msgid "Could not check the snaps"
msgstr "Kunne ikke sjekke snapene"

#. Translators: %s is a date.
#: src/gui/gaudit-window.c:216
#, c-format
msgid "Automatic updates are paused until %s"
msgstr "Automatiske oppdateringer er satt på pause til %s"

#: src/gui/gaudit-window.c:221
#, c-format
msgid "Last updated %d day ago"
msgid_plural "Last updated %d days ago"
msgstr[0] "Sist oppdatert for %d dag siden"
msgstr[1] "Sist oppdatert for %d dager siden"

#: src/gui/gaudit-window.c:227
#, c-format
msgid "%u snap is held back from updates"
msgid_plural "%u snaps are held back from updates"
msgstr[0] "%u snap holdes tilbake fra oppdateringer"
msgstr[1] "%u snaps holdes tilbake fra oppdateringer"

#: src/gui/gaudit-window.c:234
#, c-format
msgid "%u snap runs in developer mode, without a working sandbox"
msgid_plural "%u snaps run in developer mode, without a working sandbox"
msgstr[0] "%u snap kjører i utviklermodus, uten en fungerende sandkasse"
msgstr[1] "%u snaps kjører i utviklermodus, uten en fungerende sandkasse"

#: src/gui/gaudit-window.c:241
msgid "Snaps are updated automatically"
msgstr "Snaps oppdateres automatisk"

#: src/gui/gaudit-window.c:243
#, c-format
msgid "%u snap runs without a sandbox by design (classic)"
msgid_plural "%u snaps run without a sandbox by design (classic)"
msgstr[0] "%u snap kjører uten sandkasse med vilje (classic)"
msgstr[1] "%u snaps kjører uten sandkasse med vilje (classic)"

#: src/gui/gaudit-window.c:252
msgid "Snap apps"
msgstr "Snap-apper"

#. Translators: %s is a list of package systems, e.g. "rpm, Nix".
#: src/gui/gaudit-window.c:262
#, c-format
msgid "Packages managed by %s are not checked"
msgstr "Pakker som styres av %s, blir ikke sjekket"

#: src/gui/gaudit-window.c:263
msgid "Other package systems"
msgstr "Andre pakkesystemer"

#: src/gui/gaudit-window.c:268
msgid "An antivirus program is installed"
msgstr "Et antivirusprogram er installert"

#: src/gui/gaudit-window.c:269
msgid "No antivirus program found"
msgstr "Fant ikke noe antivirusprogram"

#: src/gui/gaudit-window.c:270
msgid "Antivirus program"
msgstr "Antivirusprogram"

#: src/gui/gaudit-window.c:274
msgid "A firewall is installed"
msgstr "En brannmur er installert"

#: src/gui/gaudit-window.c:275
msgid "No firewall found"
msgstr "Fant ingen brannmur"

#: src/gui/gaudit-window.c:276
msgid "Firewall program"
msgstr "Brannmurprogram"

#: src/gui/gaudit-window.c:280
msgid "Could not find out which services listen on the network"
msgstr "Kunne ikke finne ut hvilke tjenester som lytter på nettverket"

#: src/gui/gaudit-window.c:282
msgid "No services listen for connections from the network"
msgstr "Ingen tjenester lytter etter tilkoblinger fra nettverket"

#: src/gui/gaudit-window.c:285
#, c-format
msgid "%u service listens for connections from the network."
msgid_plural "%u services listen for connections from the network."
msgstr[0] "%u tjeneste lytter etter tilkoblinger fra nettverket."
msgstr[1] "%u tjenester lytter etter tilkoblinger fra nettverket."

#: src/gui/gaudit-window.c:289
msgid "None of them run under your account."
msgstr "Ingen av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:290
#, c-format
msgid "%u of them runs under your account."
msgid_plural "%u of them run under your account."
msgstr[0] "%u av dem kjører under kontoen din."
msgstr[1] "%u av dem kjører under kontoen din."

#: src/gui/gaudit-window.c:295
msgid "The firewall check shows whether they can be reached."
msgstr "Brannmursjekken viser om de kan nås."

#: src/gui/gaudit-window.c:297
msgid "Network services"
msgstr "Nettverkstjenester"

#: src/gui/gaudit-window.c:301
msgid "Could not find out where security updates come from"
msgstr "Fant ikke ut hvor sikkerhetsoppdateringene kommer fra"

#: src/gui/gaudit-window.c:303
msgid "Security updates come directly from the distribution"
msgstr "Sikkerhetsoppdateringene kommer direkte fra distribusjonen"

#. Translators: %s is a host name, e.g. no.archive.ubuntu.com.
#: src/gui/gaudit-window.c:306
#, c-format
msgid "Security updates come from %s, a mirror that may lag behind"
msgstr "Sikkerhetsoppdateringene kommer fra %s, et speil som kan ligge etter"

#: src/gui/gaudit-window.c:308
msgid "Source of security updates"
msgstr "Kilde for sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:312
msgid "Could not check the private files"
msgstr "Kunne ikke sjekke de private filene"

#: src/gui/gaudit-window.c:314
msgid "Private files and folders are protected"
msgstr "Private filer og mapper er beskyttet"

#. Translators: %s is the first file or folder, e.g. ~/.ssh/id_ed25519.
#: src/gui/gaudit-window.c:317
#, c-format
msgid "%u private file or folder can be reached by others: %s"
msgid_plural "%u private files or folders can be reached by others, e.g. %s"
msgstr[0] "%u privat fil eller mappe kan nås av andre: %s"
msgstr[1] "%u private filer eller mapper kan nås av andre, f.eks. %s"

#: src/gui/gaudit-window.c:321
msgid "Usual places for secrets"
msgstr "Vanlige steder for hemmeligheter"

#: src/gui/gaudit-window.c:327
msgid "Could not find out when updates were last checked for"
msgstr "Fant ikke ut når det sist ble sett etter oppdateringer"

#: src/gui/gaudit-window.c:331
msgid "Last checked today"
msgstr "Sist sjekket i dag"

#: src/gui/gaudit-window.c:333
#, c-format
msgid "Last checked %d day ago"
msgid_plural "Last checked %d days ago"
msgstr[0] "Sist sjekket for %d dag siden"
msgstr[1] "Sist sjekket for %d dager siden"

#: src/gui/gaudit-window.c:338
msgid "Checking for updates"
msgstr "Se etter oppdateringer"

#: src/gui/gaudit-window.c:342
msgid "Could not find out whether updates are waiting"
msgstr "Fant ikke ut om det venter oppdateringer"

#: src/gui/gaudit-window.c:344
msgid "No updates are waiting"
msgstr "Ingen oppdateringer venter"

#: src/gui/gaudit-window.c:346
#, c-format
msgid "%u update is waiting to be installed"
msgid_plural "%u updates are waiting to be installed"
msgstr[0] "%u oppdatering venter på å bli installert"
msgstr[1] "%u oppdateringer venter på å bli installert"

#: src/gui/gaudit-window.c:350
msgid "Pending updates"
msgstr "Ventende oppdateringer"

#: src/gui/gaudit-window.c:354
msgid "Could not find out where the installed packages come from"
msgstr "Fant ikke ut hvor de installerte pakkene kommer fra"

#: src/gui/gaudit-window.c:356
msgid "All packages come from a software source"
msgstr "Alle pakker kommer fra en programvarekilde"

#: src/gui/gaudit-window.c:358
#, c-format
msgid "%u package is no longer offered by any software source"
msgid_plural "%u packages are no longer offered by any software source"
msgstr[0] "%u pakke tilbys ikke lenger av noen programvarekilde"
msgstr[1] "%u pakker tilbys ikke lenger av noen programvarekilde"

#: src/gui/gaudit-window.c:362
msgid "Packages without a source"
msgstr "Pakker uten kilde"

#: src/gui/gaudit-window.c:366
msgid "Updates are installed automatically"
msgstr "Oppdateringer installeres automatisk"

#: src/gui/gaudit-window.c:368
msgid "Automatic updates are switched off"
msgstr "Automatiske oppdateringer er slått av"

#: src/gui/gaudit-window.c:369
msgid "Could not find out whether automatic updates are switched on"
msgstr "Fant ikke ut om automatiske oppdateringer er slått på"

#: src/gui/gaudit-window.c:370
msgid "Automatic updates"
msgstr "Automatiske oppdateringer"

#: src/gui/gaudit-window.c:374
msgid "Software needed to check Flatpak apps is missing"
msgstr "Programvare som trengs for å sjekke Flatpak-apper, mangler"

#: src/gui/gaudit-window.c:376
msgid "Could not check the Flatpak apps"
msgstr "Kunne ikke sjekke Flatpak-appene"

#: src/gui/gaudit-window.c:378
msgid "No apps use runtimes without security updates"
msgstr "Ingen apper bruker runtimes uten sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:383
#, c-format
msgid "%u app uses a runtime without security updates"
msgid_plural "%u apps use runtimes without security updates"
msgstr[0] "%u app bruker en runtime uten sikkerhetsoppdateringer"
msgstr[1] "%u apper bruker runtimes uten sikkerhetsoppdateringer"

#: src/gui/gaudit-window.c:388
#, c-format
msgid "%u unused outdated runtime can be removed"
msgid_plural "%u unused outdated runtimes can be removed"
msgstr[0] "%u ubrukt, utdatert runtime kan fjernes"
msgstr[1] "%u ubrukte, utdaterte runtimes kan fjernes"

#: src/gui/gaudit-window.c:393
#, c-format
msgid "%u outdated runtime is kept but not used by any app"
msgid_plural "%u outdated runtimes are kept but not used by any app"
msgstr[0] "%u utdatert runtime er beholdt, men brukes ikke av noen app"
msgstr[1] "%u utdaterte runtimes er beholdt, men brukes ikke av noen app"

#: src/gui/gaudit-window.c:408
msgid "Flatpak apps"
msgstr "Flatpak-apper"

#: src/gui/gaudit-window.c:637
msgid "Report Level"
msgstr "Rapportnivå"

#: src/gui/gaudit-window.c:698
msgid "No report at this level"
msgstr "Ingen rapport på dette nivået"

#. Translators: the level a plugin's report on Home first shows
#. * at, e.g. "Shown from Thorough".
#: src/gui/gaudit-window.c:747
#, c-format
msgid "Shown from %s"
msgstr "Vises fra %s"

#: src/gui/gaudit-window.c:751
msgid "Its check runs on the plugin's own page"
msgstr "Sjekken kjøres på pluginens egen side"

#. Translators: "<what was found> · checked at <time>", e.g.
#. * "No changed package files found · checked at 14:32".
#: src/gui/gaudit-window.c:763
#, c-format
msgid "%s · checked at %s"
msgstr "%s · sjekket kl. %s"

#: src/gui/gaudit-window.c:770 src/gui/gaudit-task-page.c:316
msgid "Not available on this system"
msgstr "Ikke tilgjengelig på dette systemet"

#: src/gui/gaudit-window.c:771 src/gui/gaudit-task-page.c:276
msgid "Software is missing"
msgstr "Programvare mangler"

#: src/gui/gaudit-window.c:773
msgid "Not run yet"
msgstr "Ikke kjørt ennå"

#: src/gui/gaudit-window.c:774
msgid "Switch to administrator to run this check"
msgstr "Bytt til administrator for å kjøre denne sjekken"

#: src/gui/gaudit-window.c:816
msgid "checked as Debian"
msgstr "sjekkes som Debian"

#: src/gui/gaudit-window.c:817
msgid "checked as Fedora"
msgstr "sjekkes som Fedora"

#: src/gui/gaudit-window.c:818
msgid "checked as Arch"
msgstr "sjekkes som Arch"

#: src/gui/gaudit-window.c:819
msgid "general checks only"
msgstr "bare generelle sjekker"

#: src/gui/gaudit-window.c:822
msgid "Unknown system"
msgstr "Ukjent system"

#. Translators: "<system> · <how gAudit checks it>",
#. * e.g. "Ubuntu 26.04 LTS · checked as Debian".
#: src/gui/gaudit-window.c:825
#, c-format
msgid "%s · %s"
msgstr "%s · %s"

#: src/gui/gaudit-window.c:828
msgid "This computer"
msgstr "Denne maskinen"

#: src/gui/gaudit-window.c:832
msgid "Unknown host name"
msgstr "Ukjent vertsnavn"

#: src/gui/gaudit-window.c:856 src/gui/gaudit-window.c:1054
msgid "Home"
msgstr "Hjem"

#: src/gui/gaudit-window.c:925
msgid "_Preferences"
msgstr "_Innstillinger"

#: src/gui/gaudit-window.c:926
msgid "_Keyboard Shortcuts"
msgstr "_Tastatursnarveier"

#. Translators: %s is the application name, which is not translated.
#: src/gui/gaudit-window.c:928
#, c-format
msgid "_About %s"
msgstr "_Om %s"

#: src/gui/gaudit-window.c:939
msgid "Main Menu"
msgstr "Hovedmeny"

#. Translators: Title of the main window and its sidebar.
#: src/gui/gaudit-window.c:1044 src/gui/gaudit-window.c:1112
msgid "Audit Center"
msgstr "Auditsenter"

#: src/gui/gaudit-window.c:1054
msgid "Overall status"
msgstr "Samlet status"

#: src/gui/gaudit-window.c:1076 src/gui/gaudit-window.c:1079
msgid "Running as you. Switch to administrator"
msgstr "Kjører som deg. Bytt til administrator"

#: src/gui/gaudit-window.c:1085 src/gui/gaudit-window.c:1088
msgid "Running with administrator rights"
msgstr "Kjører med administratorrettigheter"

#: src/gui/gaudit-window.c:1096
msgid ""
"gAudit holds administrator rights. They end 2 minutes after the last check "
"that needs them, and at the latest 30 minutes after you gave the password."
msgstr ""
"gAudit har administratorrettigheter. De slutter 2 minutter etter siste sjekk "
"som trenger dem, og senest 30 minutter etter at du ga passordet."

#: src/gui/gaudit-window.c:1102
msgid "Drop Administrator Rights"
msgstr "Slipp administratorrettigheter"

#: src/gui/gaudit-window.c:1217
msgid "Not checked: no password was given"
msgstr "Ikke sjekket: det ble ikke oppgitt noe passord"

#: src/gui/gaudit-window.c:1218
msgid "Not checked: the password was not accepted"
msgstr "Ikke sjekket: passordet ble ikke godtatt"

#: src/gui/gaudit-window.c:1219
msgid "Another check is running. Try again when it has finished"
msgstr "En annen sjekk kjører. Prøv igjen når den er ferdig"

#: src/gui/gaudit-window.c:1220 src/gui/gaudit-run-page.c:269
msgid "The check could not be completed"
msgstr "Sjekken kunne ikke fullføres"

#: src/gui/gaudit-task-page.c:45
msgid "OK"
msgstr "OK"

#: src/gui/gaudit-task-page.c:48
msgid "Needs attention"
msgstr "Trenger oppmerksomhet"

#: src/gui/gaudit-task-page.c:51
msgid "Serious"
msgstr "Alvorlig"

#: src/gui/gaudit-task-page.c:55 src/gui/gaudit-run-page.c:143
msgid "Unknown"
msgstr "Ukjent"

#: src/gui/gaudit-task-page.c:136
msgid "Opens a new page"
msgstr "Åpner en ny side"

#: src/gui/gaudit-task-page.c:173
msgid "What to check"
msgstr "Hva som skal sjekkes"

#: src/gui/gaudit-task-page.c:190
msgid "Start"
msgstr "Start"

#: src/gui/gaudit-task-page.c:212
msgid "The command shown has changed, so it was not copied"
msgstr "Kommandoen som vises er endret, så den ble ikke kopiert"

#: src/gui/gaudit-task-page.c:216
msgid "Command copied"
msgstr "Kommandoen er kopiert"

#: src/gui/gaudit-task-page.c:245 src/gui/gaudit-task-page.c:247
msgid "Copy command"
msgstr "Kopier kommandoen"

#: src/gui/gaudit-task-page.c:264
msgid "Installing is not implemented yet."
msgstr "Installering er ikke implementert ennå."

#: src/gui/gaudit-task-page.c:279
#, c-format
msgid "This check needs software that is not installed: %s."
msgstr "Denne sjekken trenger programvare som ikke er installert: %s."

#: src/gui/gaudit-task-page.c:285
msgid ""
"You can install it with the button below, or copy this command and run it in "
"a terminal yourself:"
msgstr ""
"Du kan installere den med knappen nedenfor, eller kopiere denne kommandoen "
"og kjøre den i en terminal selv:"

#: src/gui/gaudit-task-page.c:290
msgid "Install"
msgstr "Installer"

#: src/gui/gaudit-task-page.c:298
msgid ""
"Installing uses the system's software service and asks for your password."
msgstr ""
"Installeringen bruker systemets programvaretjeneste og ber om passordet ditt."

#: src/gui/gaudit-task-page.c:318
msgid "This check is not supported on this operating system yet."
msgstr "Denne sjekken støttes ikke på dette operativsystemet ennå."

#: src/gui/gaudit-run-page.c:64
msgid "To switch it on, run this command in a terminal:"
msgstr "Kjør denne kommandoen i en terminal for å slå den på:"

#: src/gui/gaudit-run-page.c:70
msgid ""
"If you use this computer from another one, for example over SSH, allow that "
"in the firewall first, or you will be shut out."
msgstr ""
"Bruker du denne datamaskinen fra en annen, for eksempel over SSH, må du "
"tillate det i brannmuren først, ellers blir du stengt ute."

#: src/gui/gaudit-run-page.c:73
msgid "No known firewall program is installed."
msgstr "Ingen kjent brannmur er installert."

#: src/gui/gaudit-run-page.c:74 src/gui/gaudit-category.c:28
msgid "Choose a Firewall"
msgstr "Velg en brannmur"

#: src/gui/gaudit-run-page.c:156
msgid "No changed package files found"
msgstr "Fant ingen endrede pakkefiler"

#: src/gui/gaudit-run-page.c:159
#, c-format
msgid "%lu package file has changed or is missing"
msgid_plural "%lu package files have changed or are missing"
msgstr[0] "%lu pakkefil er endret eller mangler"
msgstr[1] "%lu pakkefiler er endret eller mangler"

#: src/gui/gaudit-run-page.c:163
msgid "Some package files could not be checked"
msgstr "Noen pakkefiler kunne ikke sjekkes"

#. Translators: "Checked <files> files from <packages> packages (<MB> MB) in <s> seconds."
#: src/gui/gaudit-run-page.c:175
#, c-format
msgid "Checked %lu files from %lu packages (%lu MB) in %u seconds."
msgstr "Sjekket %lu filer fra %lu pakker (%lu MB) på %u sekunder."

#. Translators: Keep the meaning: no changes found is not proof.
#: src/gui/gaudit-run-page.c:180
msgid ""
"This means no changes were found, not that the computer is proven clean."
msgstr ""
"Det betyr at ingen endringer ble funnet, ikke at datamaskinen er bevist ren."

#: src/gui/gaudit-run-page.c:187
msgid "Changed"
msgstr "Endret"

#: src/gui/gaudit-run-page.c:188
msgid "The file differs from the one the package installed."
msgstr "Filen er ikke lik den pakken installerte."

#: src/gui/gaudit-run-page.c:203
msgid ""
"If you did not change these files yourself, put the packages' own files back "
"by reinstalling them:"
msgstr ""
"Hvis du ikke har endret disse filene selv, kan du legge tilbake pakkenes "
"egne filer ved å installere pakkene på nytt:"

#: src/gui/gaudit-run-page.c:208
msgid "Missing"
msgstr "Mangler"

#: src/gui/gaudit-run-page.c:209
msgid "The package installed the file, but it is gone."
msgstr "Pakken installerte filen, men den er borte."

#: src/gui/gaudit-run-page.c:212
msgid "Could not be read"
msgstr "Kunne ikke leses"

#: src/gui/gaudit-run-page.c:213
msgid ""
"Even with administrator rights, these could not be read, so they were not "
"checked."
msgstr ""
"Disse kunne ikke leses selv med administratorrettigheter, så de ble ikke "
"sjekket."

#: src/gui/gaudit-run-page.c:218
#, c-format
msgid "Showing %u of %lu files."
msgstr "Viser %u av %lu filer."

