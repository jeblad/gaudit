#. Translators: "<system> · <how gAudit checks it>",
#. * e.g. "Ubuntu 26.04 LTS · checked as Debian".
#: src/gui/gaudit-window.c:714
#, c-format
msgid "%s · %s"
msgstr "%s · %s"

#: src/gui/gaudit-window.c:717
msgid "This computer"
msgstr "Denne maskinen"

#: src/gui/gaudit-window.c:721
msgid "Unknown host name"
msgstr "Ukjent vertsnavn"

#: src/gui/gaudit-window.c:727
msgid "Checks without a password"
msgstr "Sjekker uten passord"

#: src/gui/gaudit-window.c:752
msgid "Checks"
msgstr "Sjekker"

#: src/gui/gaudit-window.c:758 src/gui/gaudit-task-page.c:213
